# MindCare-AI Environment Variables

# ===== SERVER =====
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ===== DATABASE =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mindcare_ai_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# ===== REDIS =====
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ===== JWT =====
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRE=30d

# ===== ENCRYPTION =====
ENCRYPTION_KEY=your_32_character_encryption_key
ENCRYPTION_IV=your_16_character_iv

# ===== EMAIL =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=MindCare-AI <noreply@mindcare-ai.com>

# ===== SMS (Twilio) =====
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ===== AWS S3 =====
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=ap-south-1
AWS_S3_BUCKET=mindcare-ai-bucket

# ===== GOOGLE CLOUD (for NLP) =====
GOOGLE_PROJECT_ID=your_google_project_id
GOOGLE_API_KEY=your_google_api_key

# ===== CRISIS HELPLINES =====
AASRA_PHONE=9820466726
AASRA_EMAIL=aasra@aasra.info
iCALL_PHONE=9152987821
iCALL_EMAIL=support@icallhelpline.org

# ===== ML MODEL SERVER =====
ML_SERVER_URL=http://localhost:8000
ML_API_KEY=your_ml_api_key

# ===== LOGGING =====
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ===== SECURITY =====
CORS_ORIGIN=http://localhost:3000
SESSION_SECRET=your_session_secret
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# ===== FEATURES =====
ENABLE_VOICE_CHAT=true
ENABLE_VIDEO_CHAT=false
ENABLE_OFFLINE_MODE=true
ENABLE_CRISIS_ALERTS=true

# ===== LANGUAGES =====
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,mr,ta,te,kn,bn,pa,gu,ur

# ===== ADMIN =====
ADMIN_EMAIL=admin@mindcare-ai.com
ADMIN_PASSWORD=change_this_in_production

# ===== FIREBASE (Optional - for notifications) =====
FIREBASE_PROJECT_ID=your_firebase_project
FIREBASE_PRIVATE_KEY=your_firebase_key
FIREBASE_CLIENT_EMAIL=your_firebase_email

# ===== ANALYTICS =====
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
MIXPANEL_TOKEN=your_mixpanel_token

# ===== SENTRY (Error Tracking) =====
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# ===== STRIPE (Future Payments) =====
STRIPE_PUBLIC_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key

# ===== ENVIRONMENT SPECIFIC =====
IS_PRODUCTION=false
DEBUG_MODE=true
